/*********************** EMAIL HANDLING ************************/

/**
 * Prompts the user for their email once and stores it
 * in Document Properties + displays it on Setup sheet.
 */
function getUserEmail_() {
  const props = PropertiesService.getDocumentProperties();
  let email = props.getProperty("UserEmail");

  if (!email) {
    const ui = SpreadsheetApp.getUi();
    const response = ui.prompt(
      "Enter Your Email",
      "Please enter the email you want results sent to:",
      ui.ButtonSet.OK_CANCEL
    );

    if (response.getSelectedButton() !== ui.Button.OK) {
      throw new Error("Email is required to continue.");
    }

    email = response.getResponseText().trim();
    if (!email) throw new Error("Email cannot be empty.");

    props.setProperty("UserEmail", email);

    // Display on Setup sheet
    const setupSheet = SpreadsheetApp.getActive().getSheetByName("Setup");
    setupSheet.getRange("B5").setValue(email);
  }

  return email;
}

