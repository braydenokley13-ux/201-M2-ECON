/*********************** HELPERS: SHUFFLING & SELECTING ************************/

function shuffle_(arr) {
  const copy = arr.slice();
  for (let i = copy.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    const temp = copy[i];
    copy[i] = copy[j];
    copy[j] = temp;
  }
  return copy;
}
function forceHideAnswerColumns() {
  const sheet = SpreadsheetApp.getActive().getSheetByName("Final Check");
  if (sheet) {
    sheet.hideColumns(COL_Q_CORRECT, 2); // Columns D & E
    SpreadsheetApp.getUi().alert("Columns D & E are now hidden.");
  }
}
function getRandomChapterQuestions_(chapterNum, choice) {
  const bank = CHAPTER_QUESTIONS[chapterNum] && CHAPTER_QUESTIONS[chapterNum][choice];
  if (!bank || bank.length < 5) {
    throw new Error("Not enough questions for Chapter " + chapterNum + " choice " + choice);
  }
  return shuffle_(bank).slice(0, 5);
}

function getRandomFinalQuestions_() {
  if (FINAL_QUESTIONS.length < 10) {
    throw new Error("Not enough final check questions.");
  }
  return shuffle_(FINAL_QUESTIONS).slice(0, 10);
}
function hideAnswerColumns_(sheet) {
