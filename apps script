function runFinalCheck() {
  const sheet = SpreadsheetApp.getActive().getSheetByName("Final Check");

  // Ensure email exists
  getUserEmail_();

  // Get 10 randomized final questions
  const questions = getRandomFinalQuestions_();

  // Loop through the rows where final questions go
  FINAL_Q_ROWS.forEach((row, idx) => {
    const qObj = randomizeOptions_(questions[idx]);

    // Write question and answer choices
    sheet.getRange(row, COL_Q_TEXT).setValue(qObj.q);
    sheet.getRange(row, COL_Q_OPTIONS).setValue(qObj.options);

    // Get the answer cell (Column C)
    const ansCell = sheet.getRange(row, COL_Q_ANSWER);

    // 1. Clear old value + old validation
    ansCell.clearDataValidations();
    ansCell.clearContent();

    // 2. Pre-fill with a valid value so Google Sheets won't complain
    ansCell.setValue("A");

    // 3. Apply dropdown validation (A/B/C/D only)
    ansCell.setDataValidation(
      SpreadsheetApp.newDataValidation()
        .requireValueInList(["A", "B", "C", "D"], true) // dropdown
        .setAllowInvalid(false)
        .setHelpText("Choose from A, B, C, or D")
        .build()
    );

    // 4. Flush to force Sheets to accept validation first
    SpreadsheetApp.flush();

    // 5. Now clear so the cell starts empty but valid
    ansCell.setValue("");

    // Store correct answer (D col) and question ID (E col)
    sheet.getRange(row, COL_Q_CORRECT).setValue(qObj.correct);
    sheet.getRange(row, COL_Q_ID).setValue("FQ_" + (idx + 1));
  });

  // Clear score + result fields
  sheet.getRange("B37").clearContent();
  sheet.getRange("B39").clearContent();

  // Hide correct-answer columns (D + E)
  try {
    sheet.hideColumns(COL_Q_CORRECT, 2);
  } catch (e) {
    Logger.log("Column hiding failed: " + e.message);
  }

  // Toast notification
  SpreadsheetApp.getActive().toast("Final Check questions loaded.", "Ready", 4);
}




/***********************************************************
 * OPTION RANDOMIZER — Fix for “All answers are A”
 * Shuffles A/B/C/D options and updates the correct answer.
 ***********************************************************/
function randomizeOptions_(questionObj) {
  const lines = questionObj.options.split("\n");

  // Parse into objects {label:"A", text:"Meaning", full:"A) Meaning"}
  const opts = lines.map(line => {
    const label = line.trim().charAt(0);   // A, B, C, or D
    const text = line.substring(3).trim(); // The part after "A) "
    return { label, text, full: line };
  });

  // Find the actual correct option before shuffling
  const correctLabel = questionObj.correct;
  const correctText = opts.find(o => o.label === correctLabel).text;

  // Shuffle the options
  const shuffled = shuffle_(opts.slice());

  // Reassign A/B/C/D in new order
  const newLabels = ["A", "B", "C", "D"];
  shuffled.forEach((opt, i) => {
    opt.label = newLabels[i];
    opt.full = newLabels[i] + ") " + opt.text;
  });

  // Find the NEW correct label (same text, but moved)
  const newCorrect = shuffled.find(o => o.text === correctText).label;

  // Return updated structured question
  return {
    q: questionObj.q,
    options: shuffled.map(o => o.full).join("\n"),
    correct: newCorrect
  };
}
