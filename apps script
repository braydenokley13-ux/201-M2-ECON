}
function getPastChoices_() {
  const ss = SpreadsheetApp.getActive();
  const choices = {};
  for (let i = 1; i <= 5; i++) {
    const sheet = ss.getSheetByName("Chapter " + i);
    if (!sheet) continue;
    const choice = sheet.getRange("B6").getValue().toString().trim().toUpperCase();
    if (["A", "B", "C"].includes(choice)) choices[i] = choice;
  }
  return choices;
}
