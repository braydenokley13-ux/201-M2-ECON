/*********************** HELPER: CHECK ALL CHAPTERS PASSED ************************/

function allChaptersPassed_() {
  const ss = SpreadsheetApp.getActive();
  for (let i = 0; i < CHAPTER_SHEETS.length; i++) {
    const sheet = ss.getSheetByName(CHAPTER_SHEETS[i]);
    if (!sheet) return false;
    const result = sheet.getRange("B27").getValue().toString().trim().toUpperCase();
    if (result !== "PASS") {
      return false;
    }
  }
  return true;
}

/*********************** UPDATED CHECK CHAPTER (USES SCORING + EMAIL) ************************/

function checkChapter_(chapterNum) {
  const ss = SpreadsheetApp.getActive();
  const sheet = ss.getSheetByName("Chapter " + chapterNum);

  // Ensure all answers are filled
  const allAnswered = CHAPTER_Q_ROWS.every(row => {
    const val = sheet.getRange(row, COL_Q_ANSWER).getValue().toString().trim().toUpperCase();
    return ["A", "B", "C", "D"].includes(val);
  });

  if (!allAnswered) {
    SpreadsheetApp.getUi().alert("Please answer all 5 questions before checking Chapter " + chapterNum + ".");
    return;
  }

  // Score chapter (Part 4)
  const passed = scoreChapter_(chapterNum);
  const resultText = sheet.getRange("B27").getValue().toString();

  if (passed) {
    SpreadsheetApp.getUi().alert("You PASSED Chapter " + chapterNum + "! A summary email has been sent.");
    sendChapterPassEmail_(chapterNum);
  } else {
    SpreadsheetApp.getUi().alert("You did NOT pass Chapter " + chapterNum + ". You need at least 4/5 correct.");
  }

  logEvent_("CHAPTER_CHECKED", `Chapter ${chapterNum} → Result: ${resultText}`);
}

/*********************** UPDATED CHECK FINAL CHECK (SCORING + CLAIM CODE) ************************/

function checkFinalCheck() {
  const ss = SpreadsheetApp.getActive();
  const sheet = ss.getSheetByName(SHEET_FINAL);

  // Ensure all final check questions answered
  const allAnswered = FINAL_Q_ROWS.every(row => {
    const ans = sheet.getRange(row, COL_Q_ANSWER).getValue().toString().trim().toUpperCase();
    return ["A", "B", "C", "D"].includes(ans);
  });

  if (!allAnswered) {
    SpreadsheetApp.getUi().alert("Please answer all 10 questions before checking the Final Check.");
    return;
  }

  // Score final check (Part 4)
  const passed = scoreFinalCheck_();
  const resultText = sheet.getRange("B39").getValue().toString();

  if (!passed) {
    SpreadsheetApp.getUi().alert("You did NOT pass the Final Check. You need at least 7/10 correct.");
    logEvent_("FINAL_CHECKED", `Final Check → FAIL`);
    return;
  }

  // Require all chapters to be passed to send claim code
  if (!allChaptersPassed_()) {
    SpreadsheetApp.getUi().alert(
      "You passed the Final Check, but not all chapters show PASS.\n" +
      "Make sure Chapters 1–5 are passed before claiming completion."
    );
    logEvent_("FINAL_CHECKED", `Final Check PASS but some chapters not passed.`);
    return;
  }

  // All conditions met: send completion email with claim code
  const claimCode = getRandomClaimCode_();
  sendFinalCompletionEmail_(claimCode);

  SpreadsheetApp.getUi().alert(
    "You PASSED the Final Check and all chapters!\n" +
    "A completion email with your claim code has been sent."
  );

  // Log overall completion in StudentData (WITHOUT storing claim code)
  const studentSheet = ss.getSheetByName(SHEET_STUDENT);
  const props = PropertiesService.getDocumentProperties();
  const email = props.getProperty("UserEmail") || "UNKNOWN";
  const finalScore = sheet.getRange("B37").getValue().toString();

  studentSheet.appendRow([
    timestamp_(),
    email,
    "Simulation Complete",
    "All chapters + final check passed",
    `Final: ${finalScore}`,
    "",
    "",
    finalScore,
    "CLAIM_CODE_SENT"
  ]);

  logEvent_("SIMULATION_COMPLETE", `Simulation completed by ${email}`);
}
function hideAnswerColumns_(sheet) {
