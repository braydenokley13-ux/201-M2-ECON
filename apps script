/*********************** BASIC RUN CHAPTER LOGIC ************************/

function runChapter_(chapterNum) {
  const ss = SpreadsheetApp.getActive();
  const sheet = ss.getSheetByName("Chapter " + chapterNum);

  getUserEmail_(); // force email capture

  const choice = sheet.getRange("B6").getValue().toString().trim().toUpperCase();
  if (!["A", "B", "C"].includes(choice)) {
    SpreadsheetApp.getUi().alert("Please choose A, B, or C in cell B6 before running the chapter.");
    return;
  }
  // ✅ Show the dynamic narrative
  sheet.getRange("A4").setValue(getChapterNarrative_(chapterNum));

  // ✅ Show outcome text in cell A9
  const outcome = CHAPTER_OUTCOMES[chapterNum] && CHAPTER_OUTCOMES[chapterNum][choice];
  sheet.getRange("A9").setValue(outcome || "(Outcome not defined yet.)");

  // ✅ Load 5 randomized multiple choice questions
  const questions = getRandomChapterQuestions_(chapterNum, choice);
  CHAPTER_Q_ROWS.forEach((row, idx) => {
    const qObj = randomizeOptions_(questions[idx]);

    sheet.getRange(row, COL_Q_TEXT).setValue(qObj.q);
    sheet.getRange(row, COL_Q_OPTIONS).setValue(qObj.options);

    const ansCell = sheet.getRange(row, COL_Q_ANSWER);
    clearDataValansCell.idations();
    ansCell.setValue("");
    ansCell.setDataValidation(
      SpreadsheetApp.newDataValidation()
        .requireValueInList(["A", "B", "C", "D"], true)
        .setAllowInvalid(false)
        .build()
    );

    sheet.getRange(row, COL_Q_CORRECT).setValue(qObj.correct);
    sheet.getRange(row, COL_Q_ID).setValue("CH" + chapterNum + "_" + choice + "_" + (idx + 1));
  });

  // ✅ Clear previous score
  sheet.getRange("B25").setValue("");
  sheet.getRange("B27").setValue("");

  hideAnswerColumns_(sheet);
  SpreadsheetApp.getActive().toast("Chapter " + chapterNum + " questions loaded.", "Ready", 4);
}
/*********************** BASIC CHECK CHAPTER LOGIC ************************/

function checkChapter_(chapterNum) {
  const ss = SpreadsheetApp.getActive();
  const sheet = ss.getSheetByName("Chapter " + chapterNum);

  // Ensure all questions answered
  const allAnswered = CHAPTER_Q_ROWS.every(row => {
    const val = sheet.getRange(row, COL_Q_ANSWER).getValue().toString().trim().toUpperCase();
    return ["A", "B", "C", "D"].includes(val);
  });

  if (!allAnswered) {
    SpreadsheetApp.getUi().alert("Please answer all questions before checking.");
    return;
  }

  // Placeholder scoring (real scoring added in Part 4)
  sheet.getRange("B25").setValue("0 / 5");
  sheet.getRange("B27").setValue("Incomplete — scoring added in Part 4");

  SpreadsheetApp.getActive().toast("Chapter " + chapterNum + " checked.", "Complete", 3);
}

/*********************** FINAL CHECK RUN ************************/
function runFinalCheck() {
  const sheet = SpreadsheetApp.getActive().getSheetByName("Final Check");

  // ✅ Ensure user email is stored (for tracking/progress/etc.)
  getUserEmail_();

  // ✅ Get 10 final randomized questions
  const questions = getRandomFinalQuestions_();

  // ✅ Populate questions into the defined rows
  FINAL_Q_ROWS.forEach((row, idx) => {
    const qObj = randomizeOptions_(questions[idx]);

    // 🔹 Set question text in column A
    sheet.getRange(row, COL_Q_TEXT).setValue(qObj.q);

    // 🔹 Set answer choices in column B (stacked ABCD)
    sheet.getRange(row, COL_Q_OPTIONS).setValue(qObj.options);

    // ✅ Get reference to student answer cell (column C)
    const ansCell = sheet.getRange(row, COL_Q_ANSWER);
    ansCell.clearContent();             // Clear any previous input


    // 📝 Add a helper note
    ansCell.setNote("Select your answer from the dropdown (A–D only).");

    // 🔐 Store the correct answer and question ID (to hidden columns D & E)
    sheet.getRange(row, COL_Q_CORRECT).setValue(qObj.correct); // D
    sheet.getRange(row, COL_Q_ID).setValue("FQ_" + (idx + 1)); // E
  });

  // 🧹 Clear old score/output fields
  sheet.getRange("B37").clearContent();
  sheet.getRange("B39").clearContent();

  // 🔒 Hide answer and ID columns (D and E)
  try {
    sheet.hideColumns(COL_Q_CORRECT, 2); // Columns 4 (D) + 5 (E)
  } catch (e) {
    Logger.log("Could not hide columns D & E: " + e.message);
  }

  // ✅ User feedback
  SpreadsheetApp.getActive().toast("Final Check questions loaded.", "Ready", 4);
}



