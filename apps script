/**
 * Scores a chapter after student answers questions.
 * Reads:
 *  - Question text
 *  - Student answer
 *  - Correct answer (loaded in Part 3)
 *
 * Writes:
 *  - Score (# correct)
 *  - PASS/FAIL (must score 4/5)
 * Logs results into StudentData.
 */
function scoreChapter_(chapterNum) {
  const ss = SpreadsheetApp.getActive();
  const sheet = ss.getSheetByName("Chapter " + chapterNum);

  const correctAnswers = [];
  const incorrectAnswers = [];

  CHAPTER_Q_ROWS.forEach(row => {
    const studentAns = sheet.getRange(row, COL_Q_ANSWER).getValue().toString().trim().toUpperCase();
    const correctAns = sheet.getRange(row, COL_Q_CORRECT).getValue().toString().trim().toUpperCase();

    if (studentAns === correctAns) {
      correctAnswers.push(row);
    } else {
      incorrectAnswers.push(row);
    }
  });

  const correctCount = correctAnswers.length;
  const scoreText = `${correctCount} / 5`;

  sheet.getRange("B25").setValue(scoreText);

  // REQUIRED: Must get 4/5 correct
  const passed = correctCount >= 4;
  const resultText = passed ? "PASS" : "FAIL";

  sheet.getRange("B27").setValue(resultText);

  // Log results
  logStudentChapterResult_(chapterNum, correctCount, correctAnswers, incorrectAnswers, passed);

  return passed;
}

