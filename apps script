/***********************************************************
 * MASTER SETUP — BUILDS EVERY SHEET + LAYOUT
 ***********************************************************/
function setupSimulation() {
  const ss = SpreadsheetApp.getActive();

  // 1) Ensure main sheets exist
  getOrCreateSheet_(SHEET_SETUP);
  CHAPTER_SHEETS.forEach(name => getOrCreateSheet_(name));
  getOrCreateSheet_(SHEET_FINAL);
  getOrCreateSheet_(SHEET_STUDENT);
  getOrCreateSheet_(SHEET_SYSTEMLOG);

  // 2) Lay out each sheet
  setupSetupTab_();
  setupChaptersLayout_();      // Chapter 1–5, with narrative + questions
  setupFinalCheckLayout_();    // Final Check, 10 questions
  setupStudentDataLayout_();   // StudentData headers
  setupSystemLogLayout_();     // SystemLog headers

  // 3) Apply formatting + hide backend
  applyBasicFormatting_();
  hideBackendSheets_();

  SpreadsheetApp.getActive().toast(
    "Simulation sheets created & formatted. Next: we'll wire in questions, scoring, and emails in Part 2+.",
    "Setup Complete",
    6
  );
}

